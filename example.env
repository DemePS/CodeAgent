# Copy to .env (never commit .env). Every variable CodeAgent reads for its Claude calls is listed here; commented ones are optional.
# CodeAgent also reads ~/.coding-agent/.env; a variable found first wins, and one already in the environment beats the file.

# --- Claude access: Anthropic's API, or Microsoft Foundry ----------------------------------------------------------------
# Copy to .env (never commit .env). Every variable CodeAgent reads is listed here; commented ones are optional.
# CodeAgent also reads ~/.coding-agent/.env; a variable found first wins, and one already in the environment beats the file.
# The order of reading: the environment, then the first .env found from the folder you run in upwards, then ~/.coding-agent/.env.

# --- Claude access: Anthropic's API, or Microsoft Foundry ---
ANTHROPIC_API_KEY=sk-ant-...

# Foundry instead: with an endpoint set, Foundry is used even if ANTHROPIC_API_KEY is set. The endpoint ends in /anthropic (no /v1/messages),
# the deployment is the name you gave it in Foundry (it replaces the model below). No API key: the agent signs in with your Microsoft account.
# ANTHROPIC_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic
# ANTHROPIC_FOUNDRY_DEPLOYMENT=claude-sonnet-5
# ANTHROPIC_FOUNDRY_API_KEY=
# TOKEN_SCOPE=https://ai.azure.com/.default

# DeepSeek instead (Anthropic-compatible API at https://api.deepseek.com/anthropic): set DEEPSEEK_API_KEY. It is used when no
# ANTHROPIC_API_KEY and no Foundry endpoint is set; CODEAGENT_PROVIDER=deepseek chooses it over them. The default model is
# deepseek-flash (ANTHROPIC_MODEL=deepseek-v4-pro for the larger one). With DeepSeek: no web_search tool (AGENT_WEB_SEARCH is ignored), no
# cache_control (DeepSeek caches by itself), read_pdf shows pages as images rendered by pypdfium2 (pip install "codeagent[pdf-image]"; AGENT_PDF_IMAGE_DPI=150 sets their sharpness), keep CODEAGENT_THINKING=off.
# Set AGENT_CONTEXT_WINDOW to the model's real window. (ANTHROPIC_API_KEY + ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic works too.)
# Models starting with claude-opus are mapped to deepseek-v4-pro
# Models starting with claude-haiku or claude-sonnet are mapped to deepseek-flash
# DEEPSEEK_API_KEY=
# CODEAGENT_PROVIDER=deepseek
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic    (the other way: a DeepSeek key in ANTHROPIC_API_KEY plus this URL)

# --- Model ---------------------------------------------------------------------------------------------------------------
# The Microsoft sign-in (Foundry without an API key): the Windows account, `az login`, then the Microsoft sign-in page, once.
# AZURE_TENANT_ID=                 the Foundry resource's tenant, when it is not your account's home tenant
# AZURE_CLIENT_ID=                 an app registration of your organization for the sign-in page (default: Microsoft's public Azure CLI client)
# ANTHROPIC_FOUNDRY_BROWSER_SIGN_IN=0   never open the sign-in page (servers, CI); default 1

# --- Model ---
# The agent's model (Anthropic's API only). Default: claude-sonnet-5, $2/$10 per million input/output tokens. Options:
#   claude-sonnet-5     the default; thinking can be switched off completely
#   claude-sonnet-5-5   same price; "off" means thinking: between_tools (no thinking before the answer, short notes between tool calls)
#   claude-haiku-4-5    $1/$5, the cheapest; no effort setting, weaker with tools; good for the two background models below
#   claude-opus-5-5     $4/$20;  claude-opus-5  $5/$25 (its thinking can only be disabled at effort high or lower)
#   claude-fable-5-1    $10/$50; its thinking cannot be turned off, too expensive for most uses
# ANTHROPIC_MODEL=claude-sonnet-5

# The background jobs (memory notes after a question, summary of a long conversation). Default: the agent's model.
# AGENT_MEMORY_MODEL=claude-haiku-4-5
# AGENT_COMPACT_MODEL=claude-haiku-4-5

# --- Thinking and effort (cost and speed) --------------------------------------------------------------------------------
# --- Thinking and effort (cost and speed) ---
# Thinking before the answer. Default: off. Values: off, adaptive, between_tools, disabled.
#   off            the lowest setting the model accepts: disabled, or between_tools on claude-sonnet-5-5 (it rejects disabled);
#                  nothing is sent for claude-fable-* (its thinking cannot be turned off). On Foundry the model is a deployment name:
#                  if "off" guesses wrong, name between_tools or disabled yourself.
#   adaptive       the model decides how much to think (thinking tokens are billed as output tokens)
#   between_tools  no thinking before the answer; it does not work with effort xhigh or max
#   disabled       no thinking at all (claude-sonnet-5-5 answers 400)
CODEAGENT_THINKING=off

# How much the model thinks and writes. Default: medium. Values: low, medium, high, xhigh, max, or "default" (nothing is sent, so the
# model's own default applies: high for the Sonnet models). Not used with claude-haiku-4-5. Medium is faster and cheaper than high.
CODEAGENT_EFFORT=medium

# What the agent may do in one question
# AGENT_MAX_STEPS=100     model calls per question; the turn stops there (lower it, e.g. 15, to limit the cost of a loop)
# AGENT_WEB_SEARCH=20250305     Anthropic's hosted web search the agent uses to find pages (off to disable it)
# AGENT_PDF_IMAGE_DPI=150     sharpness of the PDF pages read_pdf shows as images (DeepSeek)
# OCR of scanned PDF pages (search_pdf and read_pdf mode text): needs the tesseract program and its language packs installed on the machine
# (Debian/Ubuntu: apt install tesseract-ocr tesseract-ocr-fra tesseract-ocr-ara tesseract-ocr-eng). `coding-agent --ocr FILE` reads a whole file once.
# AGENT_OCR_LANGS=fra+ara+eng     tesseract language codes, joined with +
# AGENT_OCR_DPI=200     sharpness of the page given to tesseract
# AGENT_OCR_MAX_PAGES=20     scanned pages one search_pdf / read_pdf call may OCR (more are read by --ocr)
# AGENT_OCR_DIR=~/.coding-agent/ocr     where the text read from scanned pages is kept
# --- What the agent may do in one question ---
# AGENT_MAX_STEPS=100     model calls per question; the turn stops there (lower it, e.g. 15, to limit the cost of a loop)
# AGENT_WEB_SEARCH=20250305     Anthropic's hosted web search the agent uses to find pages (20260209 on Anthropic-hosted models only; off to disable it)
# AGENT_WEB_APPROVE=on    off: the browsing tools open any public site without asking first (a form that sends data still asks)
# AGENT_DOWNLOAD_MAX_MB=50      largest file download_file accepts
# AGENT_EXCEL_BACKEND=auto      who changes and renders workbooks: xlwings (Excel itself), openpyxl (runs anywhere), or auto
# AGENT_WEB_SESSION_DAYS=30     days a sign-in or token kept for the browsing tools is valid before it is deleted

# --- Context, memory and clean-up ---
# AGENT_CONTEXT_WINDOW=200000   tokens of context per request; older tool output is cleared at 50%, the conversation is summarised at 70%
# AGENT_CACHE_TTL=5m              how long the API keeps the cached conversation: 5m (default) or 1h (costs 2x the input price to write
#                                 instead of 1.25x, but survives pauses longer than 5 minutes between instructions)
# AGENT_MEMORY=on               off: the agent keeps no notes between sessions
# AGENT_MEMORY_DIR=             where memory and saved conversations live (default ~/.coding-agent/memory)
# AGENT_SECRETS_DIR=            where the mail / SMS logins are saved (default ~/.coding-agent/secrets, clear text, owner-only)
# AGENT_SKILLS_DIR=             a folder of your own skills (default ~/.coding-agent/skills)
# AGENT_CLEANUP=on              off: no automatic clean-up of old backups, conversations and memories
# AGENT_BACKUP_DAYS=3           days a copy of a workbook taken before a change is kept
# AGENT_CONVERSATION_DAYS=30    days a saved conversation (for --resume) is kept
# AGENT_MEMORY_DAYS=90          days a project's memory is kept when the project is not used

# --- Logs, terminal and browser ---
# AGENT_LOG=on                  off: no log file (MEMORY_HOME/<project>/agent.log, about 2 MB at most)
# AGENT_LOG_LEVEL=INFO          DEBUG also logs the model's text
# AGENT_EDITOR=vscode           the editor that file:line links in the terminal open (none: no links)
# AGENT_SYSTEM_CERTS=1          0: do not use the operating system's certificate store (a company proxy re-signs HTTPS)
# AGENT_BROWSER_PATH=           a Chrome or Chromium to use for the browsing tools and screenshots, before Playwright's own
# PLAYWRIGHT_BROWSERS_PATH=     where Playwright keeps its browsers (Playwright reads it; `coding-agent --check-browser` shows it)

# --- Internal ---
# AGENT_GUARD_WORKSPACE         set by the agent itself for the Python it runs in its sandbox; never set it yourself

# Check the whole chain (sign-in, request, streaming, thinking, tools) with:  uv run coding-agent --check

# Email (send_mail tool): the person is asked for their address and password; the SMTP server is derived from the address.
# Optional: SMTP_USER / SMTP_PASSWORD skip the questions; SMTP_HOST / SMTP_PORT / MAIL_FROM override the defaults.
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# MAIL_FROM=you@gmail.com

# SMS (send_sms tool, Twilio): anything left empty is asked once through the UI.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15551234567
