# Copy to .env (never commit .env). Every variable CodeAgent reads for its Claude calls is listed here; commented ones are optional.
# CodeAgent also reads ~/.coding-agent/.env; a variable found first wins, and one already in the environment beats the file.

# --- Claude access: Anthropic's API, or Microsoft Foundry ----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Foundry instead: with an endpoint set, Foundry is used even if ANTHROPIC_API_KEY is set. The endpoint ends in /anthropic (no /v1/messages),
# the deployment is the name you gave it in Foundry (it replaces the model below). No API key: the agent signs in with your Microsoft account.
# ANTHROPIC_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic
# ANTHROPIC_FOUNDRY_DEPLOYMENT=claude-sonnet-5
# ANTHROPIC_FOUNDRY_API_KEY=
# TOKEN_SCOPE=https://ai.azure.com/.default

# --- Model ---------------------------------------------------------------------------------------------------------------
# The agent's model (Anthropic's API only). Default: claude-sonnet-5, $2/$10 per million input/output tokens. Options:
#   claude-sonnet-5     the default; thinking can be switched off completely
#   claude-sonnet-5-5   same price; "off" means thinking: between_tools (no thinking before the answer, short notes between tool calls)
#   claude-haiku-4-5    $1/$5, the cheapest; no effort setting, weaker with tools; good for the two background models below
#   claude-opus-5-5     $4/$20;  claude-opus-5  $5/$25 (its thinking can only be disabled at effort high or lower)
#   claude-fable-5-1    $10/$50; its thinking cannot be turned off, too expensive for most uses
# ANTHROPIC_MODEL=claude-sonnet-5

# The background jobs (memory notes after a question, summary of a long conversation). Default: the agent's model.
# AGENT_MEMORY_MODEL=claude-haiku-4-5
# AGENT_COMPACT_MODEL=claude-haiku-4-5

# --- Thinking and effort (cost and speed) --------------------------------------------------------------------------------
# Thinking before the answer. Default: off. Values: off, adaptive, between_tools, disabled.
#   off            the lowest setting the model accepts: disabled, or between_tools on claude-sonnet-5-5 (it rejects disabled);
#                  nothing is sent for claude-fable-* (its thinking cannot be turned off). On Foundry the model is a deployment name:
#                  if "off" guesses wrong, name between_tools or disabled yourself.
#   adaptive       the model decides how much to think (thinking tokens are billed as output tokens)
#   between_tools  no thinking before the answer; it does not work with effort xhigh or max
#   disabled       no thinking at all (claude-sonnet-5-5 answers 400)
CODEAGENT_THINKING=off

# How much the model thinks and writes. Default: medium. Values: low, medium, high, xhigh, max, or "default" (nothing is sent, so the
# model's own default applies: high for the Sonnet models). Not used with claude-haiku-4-5. Medium is faster and cheaper than high.
CODEAGENT_EFFORT=medium

# What the agent may do in one question
# AGENT_MAX_STEPS=100     model calls per question; the turn stops there (lower it, e.g. 15, to limit the cost of a loop)
# AGENT_WEB_SEARCH=20250305     Anthropic's hosted web search the agent uses to find pages (off to disable it)

# Check the whole chain (sign-in, request, streaming, thinking, tools) with:  uv run coding-agent --check
